{"id": "endpoint-nystagmus", "site": "eye", "definition": {"obs": "eyes.nystagmus", "path": "physiological", "op": "eq", "value": true, "ctx": {"gaze": ["left", "right", "up", "down"]}}, "normalVariant": true, "note": "The model flags drift from a healthy integrator alone as physiological (Ritter 2020).", "status": "draft"},
