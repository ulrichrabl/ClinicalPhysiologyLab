{"id": "t-wave-inversion", "site": "ecg", "definition": {"fn": "ecgContiguous", "args": {"field": "t", "op": "le", "value": -0.1, "exclude": ["aVR", "V1"]}}, "threshold": {"text": "T deeper than 0.1 mV in two contiguous leads (aVR and V1 left out, where it is normal)", "status": "standard", "refs": ["thygesen2018"]}, "status": "draft"},
{"id": "tall-t-waves", "site": "ecg", "definition": {"any": [{"fn": "ecgAnyLead", "args": {"field": "t", "leads": ["I", "II", "III", "aVL", "aVF"], "op": "ge", "value": 0.5}}, {"fn": "ecgAnyLead", "args": {"field": "t", "leads": ["V1", "V2", "V3", "V4", "V5", "V6"], "op": "ge", "value": 1.0}}]}, "threshold": {"text": "T ≥ 0.5 mV in a limb lead or ≥ 1.0 mV in a chest lead", "status": "assumed"}, "status": "draft"},
{"id": "u-waves", "site": "ecg", "definition": {"obs": "ecg.reading", "path": "u", "op": "ge", "value": 0.1}, "threshold": {"text": "a positive wave ≥ 0.1 mV after T in V2 or V3", "status": "assumed"}, "status": "draft"},
{"id": "long-qtc", "site": "ecg", "definition": {"obs": "ecg.reading", "path": "qtc", "op": "gt", "value": 460}, "threshold": {"text": "QTc > 460 ms (Bazett)", "status": "standard", "refs": ["rautaharju2009"]}, "status": "draft"},
{"id": "lvh-voltage", "site": "ecg", "definition": {"obs": "ecg.reading", "path": "sokolow", "op": "ge", "value": 3.5}, "threshold": {"text": "S in V1 plus the larger R in V5 or V6 ≥ 3.5 mV", "status": "standard", "refs": ["sokolow1949"]}, "status": "draft"},
