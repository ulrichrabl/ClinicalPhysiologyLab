{
  "schema": "vp.scenario/1",
  "id": "arrest-practice",
  "version": "0.3.0",
  "status": "draft",
  "title": {
    "en": "Practice: cardiac arrest",
    "de": "Übung: Herz-Kreislauf-Stillstand"
  },
  "caseId": "free-patient",
  "purpose": "A practice screen after ADR-018 step 4: a healthy man whose heart fibrillates a few seconds in; the nurse goes for the arrest trolley and is back a minute later with the defibrillator, a cannula and the drugs, so the learner starts alone. A bag-mask on the wall. Compressions, breaths, shocks, IV access, adrenaline and amiodarone. For the owner to try.",
  "scene": {
    "place": {
      "en": "A side room on the ward",
      "de": "Ein Nebenzimmer auf Station"
    },
    "people": [
      {
        "id": "nurse",
        "role": {
          "en": "Nurse",
          "de": "Pflegekraft"
        },
        "present": true
      }
    ],
    "equipment": [
      {
        "id": "bag-mask",
        "label": {
          "en": "Bag-valve-mask on the wall",
          "de": "Beatmungsbeutel mit Maske an der Wand"
        },
        "present": true
      },
      {
        "id": "defibrillator",
        "label": {
          "en": "Arrest trolley with a defibrillator",
          "de": "Notfallwagen mit Defibrillator"
        },
        "present": false
      },
      {
        "id": "cannula-kit",
        "label": {
          "en": "IV cannulas on the arrest trolley",
          "de": "Venenverweilkanülen am Notfallwagen"
        },
        "present": false
      },
      {
        "id": "drugs",
        "label": {
          "en": "Adrenaline and amiodarone on the arrest trolley",
          "de": "Adrenalin und Amiodaron am Notfallwagen"
        },
        "present": false
      }
    ]
  },
  "machine": {
    "start": "talking",
    "states": {
      "talking": {
        "label": {
          "en": "Talking",
          "de": "Im Gespräch"
        },
        "enter": [
          {
            "say": {
              "who": "patient",
              "text": {
                "en": "I feel a bit odd…",
                "de": "Mir ist irgendwie komisch…"
              }
            }
          }
        ],
        "next": [
          {
            "when": {
              "inStateFor": 4
            },
            "to": "arrest"
          }
        ]
      },
      "arrest": {
        "label": {
          "en": "Cardiac arrest",
          "de": "Herz-Kreislauf-Stillstand"
        },
        "enter": [
          {
            "change": [
              {
                "path": "electrical.ventricular",
                "set": "vf"
              }
            ]
          },
          {
            "say": {
              "who": "nurse",
              "text": {
                "en": "He’s collapsed! He isn’t responding. I’ll get the arrest trolley.",
                "de": "Er ist zusammengebrochen! Er reagiert nicht. Ich hole den Notfallwagen."
              }
            }
          },
          {
            "leave": {
              "people": [
                "nurse"
              ]
            }
          },
          {
            "arrive": {
              "people": [
                "nurse"
              ],
              "equipment": [
                "defibrillator",
                "cannula-kit",
                "drugs"
              ],
              "afterSeconds": 60
            }
          }
        ],
        "next": [
          {
            "when": {
              "at": 1200
            },
            "to": "end"
          }
        ]
      },
      "end": {
        "label": {
          "en": "Twenty minutes",
          "de": "Zwanzig Minuten"
        },
        "final": true
      }
    }
  }
}
