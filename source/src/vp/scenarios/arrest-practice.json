{
  "schema": "vp.scenario/1",
  "id": "arrest-practice",
  "version": "0.4.0",
  "status": "draft",
  "title": {
    "en": "Practice: cardiac arrest",
    "de": "Übung: Herz-Kreislauf-Stillstand"
  },
  "caseId": "free-patient",
  "purpose": "A practice arrest after ADR-018 step 5 part 2: a healthy man whose heart fibrillates a few seconds in, with one nurse in the room. The learner leads: has the arrest team called (it comes 2 min after the call, with the trolley: defibrillator, cannulas, drugs; 90 s later if the call does not say where), or sends the nurse for the trolley (back in 60 s), and gives the tasks. The team's times are placements: the ADR's 2 min, a call of 15 s, a delay of 90 s for a call without a place.",
  "scene": {
    "place": {
      "en": "A side room on the ward",
      "de": "Ein Nebenzimmer auf Station"
    },
    "people": [
      {
        "id": "nurse",
        "role": {
          "en": "Nurse",
          "de": "Pflegekraft"
        },
        "present": true
      },
      {
        "id": "doctor",
        "role": {
          "en": "Doctor (arrest team)",
          "de": "Ärztin (Reanimationsteam)"
        },
        "present": false
      },
      {
        "id": "nurse2",
        "role": {
          "en": "Nurse (arrest team)",
          "de": "Pflegekraft (Reanimationsteam)"
        },
        "present": false
      }
    ],
    "equipment": [
      {
        "id": "bag-mask",
        "label": {
          "en": "Bag-valve-mask on the wall",
          "de": "Beatmungsbeutel mit Maske an der Wand"
        },
        "present": true
      },
      {
        "id": "defibrillator",
        "label": {
          "en": "Arrest trolley with a defibrillator",
          "de": "Notfallwagen mit Defibrillator"
        },
        "present": false
      },
      {
        "id": "cannula-kit",
        "label": {
          "en": "IV cannulas on the arrest trolley",
          "de": "Venenverweilkanülen am Notfallwagen"
        },
        "present": false
      },
      {
        "id": "drugs",
        "label": {
          "en": "Adrenaline and amiodarone on the arrest trolley",
          "de": "Adrenalin und Amiodaron am Notfallwagen"
        },
        "present": false
      }
    ],
    "team": {
      "people": [
        "doctor",
        "nurse2"
      ],
      "equipment": [
        "defibrillator",
        "cannula-kit",
        "drugs"
      ],
      "afterSeconds": 120,
      "lateWithoutWhere": 90,
      "callSeconds": 15
    }
  },
  "machine": {
    "start": "talking",
    "states": {
      "talking": {
        "label": {
          "en": "Talking",
          "de": "Im Gespräch"
        },
        "enter": [
          {
            "say": {
              "who": "patient",
              "text": {
                "en": "I feel a bit odd…",
                "de": "Mir ist irgendwie komisch…"
              }
            }
          }
        ],
        "next": [
          {
            "when": {
              "inStateFor": 4
            },
            "to": "arrest"
          }
        ]
      },
      "arrest": {
        "label": {
          "en": "Cardiac arrest",
          "de": "Herz-Kreislauf-Stillstand"
        },
        "enter": [
          {
            "change": [
              {
                "path": "electrical.ventricular",
                "set": "vf"
              }
            ]
          },
          {
            "say": {
              "who": "nurse",
              "text": {
                "en": "He’s collapsed! He isn’t responding. What shall I do?",
                "de": "Er ist zusammengebrochen! Er reagiert nicht. Was soll ich tun?"
              }
            }
          }
        ],
        "next": [
          {
            "when": {
              "at": 1200
            },
            "to": "end"
          }
        ]
      },
      "end": {
        "label": {
          "en": "Twenty minutes",
          "de": "Zwanzig Minuten"
        },
        "final": true
      }
    }
  }
}
